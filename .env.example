# Owner connection: runs migrations (bypasses RLS). Never used by the running app.
DATABASE_URL=postgres://destra:destra@localhost:5432/destra
# App connection: login role that is a member of destra_app (RLS enforced).
DATABASE_APP_URL=postgres://destra_api:destra_api@localhost:5432/destra

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
PANEL_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Instagram via Facebook Login). The integration stays off until these are set.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# For local development against scripts/fake-meta.mjs, set both to http://127.0.0.1:4100
META_GRAPH_URL=https://graph.facebook.com
META_DIALOG_URL=https://www.facebook.com
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=destra-main
