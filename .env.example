# Owner connection: runs migrations (bypasses RLS). Never used by the running app.
DATABASE_URL=postgres://destra:destra@localhost:5432/destra
# App connection: login role that is a member of destra_app (RLS enforced).
DATABASE_APP_URL=postgres://destra_api:destra_api@localhost:5432/destra

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
PANEL_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=destra-main
